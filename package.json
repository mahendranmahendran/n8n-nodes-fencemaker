{
  "name": "n8n-nodes-fencemaker",
  "version": "0.1.0",
  "description": "n8n community node for fencemaker: read vehicle/geofence/trip data, create trips and geofences, and trigger workflows from fencemaker events.",
  "license": "MIT",
  "homepage": "https://github.com/mahendranmahendran/n8n-nodes-fencemaker",
  "keywords": ["n8n-community-node-package"],
  "author": { "name": "Mahendran", "email": "mahendranmahendran@gmail.com" },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahendranmahendran/n8n-nodes-fencemaker.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist", "!dist/tsconfig.tsbuildinfo"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/FencemakerApi.credentials.js"],
    "nodes": [
      "dist/nodes/Fencemaker/Fencemaker.node.js",
      "dist/nodes/FencemakerTrigger/FencemakerTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
